# Copy to .env (gitignored) and fill in locally. Never commit .env or put keys in the repo.
# Auth is Microsoft Entra ID through DefaultAzureCredential: run `az login` first. No key needed.

# Azure OpenAI / Azure AI Foundry chat deployment used by the guarded phraser
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<your-chat-deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional fallback only if Entra ID is not possible. Leave unset; it is never logged.
# AZURE_OPENAI_API_KEY=

# Telemetry: Application Insights connection string (else spans go nowhere, or to a local file)
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# OPTIX_TRACE_FILE=out/spans.jsonl
# OPTIX_TRACE_CONSOLE=1

# API service (service/app.py)
# OPTIX_DATA_DIR=web/public/data
# OPTIX_WEB_DIST=web/dist
# OPTIX_MAX_SPEED=600
