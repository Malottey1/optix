{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optix.local/contracts/claim.schema.json",
  "title": "Intermediate Claim Object",
  "description": "A language-independent statement of fact about a match. The Analyst produces it from computed metrics, the Verifier checks it against the event log, and only a verified claim may be turned into text and translated. Contains no prose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "match_id",
    "claim_type",
    "metric",
    "subject",
    "value",
    "window",
    "game_state",
    "evidence_event_ids",
    "verification"
  ],
  "properties": {
    "claim_id": { "type": "string", "description": "Unique id, stable across retries." },
    "match_id": { "type": "string" },
    "claim_type": {
      "type": "string",
      "enum": ["stat", "comparison", "trend", "matchup", "milestone", "descriptive_change", "causal"],
      "description": "'causal' claims are always blocked by the Verifier (rule causal_claim); the type exists so they can be detected and rejected."
    },
    "metric": {
      "type": "string",
      "enum": [
        "xg", "npxg", "open_play_xa", "xt_added", "pass_quality_ratio",
        "field_tilt", "ppda", "territorial_stress", "shot_cluster_score",
        "possession_pct", "momentum", "rhythm_index", "zone_mismatch",
        "chances_created", "forward_passes", "passes_completed",
        "ball_speed", "shot_speed", "possession_changes_per_min",
        "red_card_segment_delta", "milestone_count"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "enum": ["team", "player", "match", "zone"] },
        "id": { "type": "string" },
        "team_code": { "type": "string", "description": "Fictional 3-letter team code." }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "unit"],
      "properties": {
        "amount": { "type": "number" },
        "unit": { "type": "string", "enum": ["count", "ratio", "percent", "xg", "xt", "seconds", "per_min", "per_10min", "m_per_s", "score_0_100"] },
        "baseline": { "type": ["number", "null"], "description": "League, role or own-baseline value used for comparison." },
        "baseline_kind": { "type": ["string", "null"], "enum": ["league_avg", "role_baseline", "own_season", "same_game_state", "same_minute", null] },
        "z_score": { "type": ["number", "null"] },
        "sample_size": { "type": "integer", "minimum": 0 }
      }
    },
    "zone": {
      "type": ["object", "null"],
      "description": "Pitch zone, always from the attacking team's point of view.",
      "additionalProperties": false,
      "properties": {
        "lane": { "type": "string", "enum": ["left_flank", "left_half_space", "center", "right_half_space", "right_flank"] },
        "third": { "type": "string", "enum": ["defensive", "middle", "attacking"] }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_sec", "to_sec"],
      "description": "Match clock in seconds from kickoff of the first half (second half starts at 2700).",
      "properties": {
        "from_sec": { "type": "integer", "minimum": 0 },
        "to_sec": { "type": "integer", "minimum": 0 }
      }
    },
    "game_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score_diff_for_subject", "bracket"],
      "properties": {
        "score_diff_for_subject": { "type": "integer" },
        "bracket": { "type": "string", "enum": ["leading_2plus", "leading_1", "level", "trailing_1", "trailing_2plus"] },
        "red_cards_for": { "type": "integer", "minimum": 0, "default": 0 },
        "red_cards_against": { "type": "integer", "minimum": 0, "default": 0 }
      }
    },
    "evidence_event_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Event IDs that prove the claim. A claim without evidence cannot be verified and is blocked."
    },
    "template_key": {
      "type": ["string", "null"],
      "description": "Key of the sentence template the Narrative agent should fill, e.g. 'matchup.weak_flank'. Text is generated from template_key + params, never from free invention."
    },
    "params": {
      "type": "object",
      "description": "Named values the template may use (team codes, player ids, percentages). Every number here must equal a number in value or the evidence.",
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "published", "published_with_context", "blocked"]
        },
        "fact_check": { "type": ["string", "null"], "enum": ["pass", "fail", null] },
        "actual_value": { "type": ["number", "null"], "description": "Value recomputed by the Verifier from the event log." },
        "context_check": { "type": ["string", "null"], "enum": ["ok", "misleading", null] },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "field_tilt_with_lead", "shot_spam", "set_piece_inflation",
              "wide_forward_passes", "small_sample_xg", "ppda_alone",
              "causal_claim", "causal_red_card", "single_match_fatigue",
              "missing_evidence", "value_mismatch"
            ]
          }
        },
        "context_note": { "type": ["string", "null"], "description": "Machine-readable key for the caveat to attach (not prose), e.g. 'field_tilt.trailing_vs_deep_block'." },
        "attempt": { "type": "integer", "minimum": 1, "description": "Rewrite attempt number. A blocked claim may be revised by the Narrative/Analyst agents and re-verified." },
        "verified_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
